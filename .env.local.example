# Opcional para compose.local.yaml: copiar como .env.local y usar --env-file .env.local
# solo si hace falta cambiar puertos o depuración. Sin este archivo se usan estos mismos valores.

GATEWAY_PORT=8080
GESTION_DESPACHOS_PORT=8081
OPERACION_REPARTO_PORT=8082
SEGURIDAD_LOCAL_PORT=8090
ADMINER_PORT=8088

# PostgreSQL local (una base por microservicio en el mismo contenedor).
LOCAL_DB_PORT=15432
LOCAL_DB_USUARIO=despacho_local
LOCAL_DB_CLAVE=despacho-local-no-produccion

# Depuración remota JDWP (IntelliJ / VS Code: "Attach" a localhost:<puerto>).
GESTION_DEBUG_PORT=5005
OPERACION_DEBUG_PORT=5006
GATEWAY_DEBUG_PORT=5007
# y = la JVM espera al depurador antes de arrancar (para depurar el inicio).
JAVA_DEBUG_SUSPEND=n

# Evidencias: vacío deja la carga/lectura de fotos no disponible en local.
EVIDENCIAS_STORAGE_URL=
EVIDENCIAS_BUCKET=
EVIDENCIAS_CLAVE_SERVICIO=

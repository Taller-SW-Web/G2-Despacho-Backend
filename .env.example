# Entorno opcional del compose.yaml local. Docker Compose aplica estos valores si no existe .env.
# Para Render, usar la plantilla del servicio correspondiente. Las credenciales de este archivo son ficticias.

# ==================== Puertos locales ====================

# Puerto del Gateway publicado en localhost.
GATEWAY_PORT=8080
# Puerto de Gestión publicado en localhost.
GESTION_DESPACHOS_PORT=8081
# Puerto de Operación publicado en localhost.
OPERACION_REPARTO_PORT=8082
# Puerto del emisor temporal de Seguridad publicado en localhost.
SEGURIDAD_LOCAL_PORT=8090
# Puerto de PostgreSQL local publicado en localhost.
LOCAL_DB_PORT=15432

# ==================== PostgreSQL local ====================

# Usuario de las dos bases de desarrollo en el mismo PostgreSQL local.
LOCAL_DB_USUARIO=despacho_local
# Contraseña ficticia de PostgreSQL local.
LOCAL_DB_CLAVE=despacho-local-no-produccion

# ==================== CORS y límites ====================

# Orígenes de los frontends locales admitidos por el Gateway, separados por comas.
CORS_ORIGENES=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Tamaño máximo del cuerpo que admite el Gateway, en bytes.
SOLICITUD_MAXIMO_BYTES=1048576
# Máximo de llamadas a POST /api/v1/cotizaciones por minuto para cada combinación de cliente e IP.
# Al superar el cupo, Gestión responde HTTP 429 hasta que empieza el siguiente minuto.
LIMITE_COTIZACIONES_POR_MINUTO=60

# ==================== Evidencias de entrega ====================

# URL base del proyecto Supabase Storage que aloja las fotos de evidencia.
EVIDENCIAS_STORAGE_URL=
# Nombre del bucket privado de evidencias.
EVIDENCIAS_BUCKET=
# Clave de servicio del proyecto de Storage, de uso exclusivo del backend.
EVIDENCIAS_CLAVE_SERVICIO=
# Tipos MIME admitidos en fotos de evidencia, separados por comas.
EVIDENCIAS_TIPOS_PERMITIDOS=image/jpeg,image/png,image/webp
# Tamaño máximo de una foto de evidencia, en bytes.
EVIDENCIAS_MAXIMO_BYTES=2097152

# ==================== Integración con Productos ====================

# URL base de Productos, sin /api/v1. El servicio externo se ejecuta fuera de este Compose.
PRODUCTOS_URL=http://host.docker.internal:8083
# Identificador técnico de Gestión para consultar los datos físicos de los SKU.
PRODUCTOS_CLIENT_ID=modulo-despacho
# Secreto de cliente para solicitar el token. El emisor local no concede el scope de Productos.
PRODUCTOS_CLIENT_SECRET=
# Token técnico suministrado externamente, con aud=api-productos y scope productos:fisicos:leer.
PRODUCTOS_TOKEN_SERVICIO=

# ==================== Eventos hacia Ventas ====================

# URL base de Ventas, sin /api/v1. Gestión agrega la ruta del webhook.
VENTAS_URL=http://host.docker.internal:8084
# Identificador técnico de Gestión para enviar eventos de estado a Ventas.
VENTAS_CLIENT_ID=modulo-despacho
# Secreto de cliente para solicitar el token. El emisor local no concede el scope de Ventas.
VENTAS_CLIENT_SECRET=
# Token técnico suministrado externamente, con aud=api-ventas y scope ventas:pedidos:estado.
VENTAS_TOKEN_SERVICIO=

# Configuración de Docker Compose. Copiar como .env y completar la URL real.
# Compose lee este archivo solamente cuando se llama .env o se indica con --env-file.
# Origen de Seguridad sin /api/v1/auth al final.
# Si Seguridad corre en este equipo: http://host.docker.internal:<puerto>
SEGURIDAD_URL=
SEGURIDAD_AUDIENCIA=api-despacho
# Valor inicial: confirmar el algoritmo de firma publicado por Seguridad.
SEGURIDAD_ALGORITMO=RS256

# Puertos publicados en tu equipo; los puertos internos permanecen fijos.
GATEWAY_PORT=8080
GESTION_DESPACHOS_PORT=8081
OPERACION_REPARTO_PORT=8082

# Orígenes del frontend. Compose agrega los dos Swagger UI según sus puertos.
CORS_ORIGENES=http://localhost:5173,http://localhost:5174
SOLICITUD_MAXIMO_BYTES=1048576

# Opcional: copiar como .env para cambiar los valores del único compose.yaml local.
# El arranque también funciona sin .env: Compose tiene estos valores por defecto.
# Credenciales ficticias exclusivamente locales. No guardar secretos reales en Git.
GATEWAY_PORT=8080
GESTION_DESPACHOS_PORT=8081
OPERACION_REPARTO_PORT=8082
SEGURIDAD_LOCAL_PORT=8090
LOCAL_DB_PORT=15432
LOCAL_DB_USUARIO=despacho_local
LOCAL_DB_CLAVE=despacho-local-no-produccion
CORS_ORIGENES=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
SOLICITUD_MAXIMO_BYTES=1048576

# Fotografías: dejar vacío mantiene el almacenamiento no disponible en local.
EVIDENCIAS_STORAGE_URL=
EVIDENCIAS_BUCKET=
EVIDENCIAS_CLAVE_SERVICIO=
EVIDENCIAS_TIPOS_PERMITIDOS=image/jpeg,image/png,image/webp
EVIDENCIAS_MAXIMO_BYTES=2097152

# Integraciones externas opcionales de Gestión; no se levantan en este Compose.
# PRODUCTOS_URL=http://host.docker.internal:8083
# PRODUCTOS_CLIENT_ID=modulo-despacho
# PRODUCTOS_CLIENT_SECRET=<secreto-fuera-de-git>
# PRODUCTOS_TOKEN_SERVICIO=<jwt-tecnico-opcional>
# VENTAS_URL=http://host.docker.internal:8084
# VENTAS_CLIENT_ID=modulo-despacho
# VENTAS_CLIENT_SECRET=<secreto-fuera-de-git>
# VENTAS_TOKEN_SERVICIO=<jwt-tecnico-opcional>

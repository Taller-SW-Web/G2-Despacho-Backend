# Referencia para ejecutar el doble de Ventas directamente con Java.
# Java lee estas variables del proceso. Docker Compose ya fija su propio entorno.
# Este doble es exclusivo de desarrollo local: no es Ventas y Postventa real.

# ==================== Habilitación ====================

# Habilitación explícita del doble temporal en una ejecución local.
HABILITAR_VENTAS_LOCAL=true

# ==================== Red local ====================

# Puerto HTTP del doble.
PORT=8084
# Limita la escucha a la máquina local en la ejecución directa.
DIRECCION_ESCUCHA=127.0.0.1

# ==================== Seguridad ====================

# Origen del emisor de tokens; de aquí se leen el issuer y el JWKS.
SEGURIDAD_URL=http://127.0.0.1:8090

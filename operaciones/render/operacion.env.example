SPRING_PROFILES_ACTIVE=render
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
SEGURIDAD_ALGORITMO=RS256
# Base exclusiva: Operadores y Flota (región este). Copiar valores privados desde Supabase al panel de Render.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-de-esta-base>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-de-esta-base>
SPRING_DATASOURCE_PASSWORD=<secreto-fuera-de-git>
SPRING_FLYWAY_ENABLED=false
DB_POOL_MAXIMO=5
GATEWAY_PUBLIC_URL=https://g2-despacho-backend.onrender.com
DOCUMENTACION_HABILITADA=false
# Lectura de evidencias (bucket privado de F-03; secretos exclusivamente en el servidor).
EVIDENCIAS_STORAGE_URL=https://<proyecto-storage>.supabase.co
EVIDENCIAS_BUCKET=<bucket-privado>
EVIDENCIAS_CLAVE_SERVICIO=<clave-de-servicio-fuera-de-git>

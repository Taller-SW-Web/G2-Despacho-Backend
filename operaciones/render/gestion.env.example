SPRING_PROFILES_ACTIVE=render
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
SEGURIDAD_ALGORITMO=RS256
# Base exclusiva: Servicio Logístico (región oeste). Copiar valores privados desde Supabase al panel de Render.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-de-esta-base>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-de-esta-base>
SPRING_DATASOURCE_PASSWORD=<secreto-fuera-de-git>
SPRING_FLYWAY_ENABLED=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
GATEWAY_PUBLIC_URL=https://taller-api-gateway.onrender.com
DOCUMENTACION_HABILITADA=false
OPERACION_REPARTO_URL=https://taller-servicio-operacion-reparto.onrender.com
OPERACION_CAPACIDAD_SCOPES=operacion:capacidad:reservar operacion:capacidad:liberar operacion:proyecciones:escribir
# Conceder esos scopes al cliente real en Seguridad; no guardar secretos aquí.

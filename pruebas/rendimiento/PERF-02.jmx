          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Sesión del gestor">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">vars.put('token', props.get('tokenGestor'))</stringProp>
</JSR223PreProcessor>
<hashTree/>
        <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Turnos globales por fase">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">def fases = props.get('colaFasesLista')
if (fases == null) {
    fases = []
    long desde = 0
    for (parte in vars.get('fases').split(',')) {
        def campos = parte.trim().split(':')
        long hasta = desde + (campos[1] as long) * 1000
        fases &lt;&lt; [etiqueta: campos[0], desde: desde, hasta: hasta, intervalo: 1000.0d / (campos[2] as double)]
        desde = hasta
    }
    props.putIfAbsent('colaFasesLista', fases)
    fases = props.get('colaFasesLista')
}
long ahora = System.currentTimeMillis()
props.putIfAbsent('colaInicio', ahora)
long inicio = props.get('colaInicio') as long
if (props.putIfAbsent('ventanasGuardadas', true) == null) {
    def limites = fases.collectEntries { [(it.etiqueta): [inicioMs: inicio + it.desde, duracionS: (it.hasta - it.desde) / 1000]] }
    new File(props.getProperty('ventanas', 'ventanas.json')).text = groovy.json.JsonOutput.toJson(limites)
}
synchronized (fases) {
    double siguiente = (props.get('colaSiguiente') ?: (double) inicio) as double
    double turno = Math.max(siguiente, (double) ahora)
    long transcurrido = (long) turno - inicio
    def fase = fases.find { transcurrido &gt;= it.desde &amp;&amp; transcurrido &lt; it.hasta }
    vars.put('faseCola', fase ? fase.etiqueta : 'COLA-EXCEDENTE')
    props.put('colaSiguiente', turno + (fase ? fase.intervalo : 1000.0d))
    return Math.max(0L, (long) turno - ahora)
}</stringProp>
</JSR223Timer>
<hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="COLA">
          <stringProp name="HTTPSampler.path">/api/v1/despachos/pendientes?pagina=${pagina}&amp;tamanoPagina=100</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Página completa y en orden">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Página completa: totales del lote, 100 filas y los IDs esperados en su orden, sin duplicados.
import groovy.json.JsonSlurper
if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('HTTP_' + prev.getResponseCode())
    return
}
def pagina
try {
    pagina = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('RESPUESTA_INVALIDA')
    return
}
def total = (props.getProperty('totalEsperado', '10000')) as long
def fallos = []
if (pagina.totalElementos != total) fallos &lt;&lt; 'TOTAL_ELEMENTOS'
if (pagina.totalPaginas != total.intdiv(100)) fallos &lt;&lt; 'TOTAL_PAGINAS'
def obtenidos = (pagina.contenido ?: []).collect { it.idDespacho }
if (obtenidos.size() != 100) fallos &lt;&lt; 'PAGINA_INCOMPLETA'
if (obtenidos.toSet().size() != obtenidos.size()) fallos &lt;&lt; 'IDS_DUPLICADOS'
if (obtenidos != vars.get('ids').split(';').toList()) fallos &lt;&lt; 'IDS_INCORRECTOS'
if (fallos) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(fallos.join(' '))
}</stringProp>
</JSR223Assertion>
<hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Etiqueta de la fase">
  <stringProp name="scriptLanguage">groovy</stringProp>

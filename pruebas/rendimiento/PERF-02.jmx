        <boolProp name="ignoreFirstLine">false</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="SETUP-sesion">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP-sesion">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Fuera de la medición: sesión del gestor en la propiedad tokenGestor.
import java.net.http.*
import java.net.URI
def emisor = props.getProperty('seguridad', 'http://127.0.0.1:18090')
def solicitud = HttpRequest.newBuilder(URI.create(emisor + '/pruebas/token-usuario'))
    .header('Content-Type', 'application/x-www-form-urlencoded')
    .POST(HttpRequest.BodyPublishers.ofString('perfil=gestor')).build()
def respuesta = HttpClient.newHttpClient().send(solicitud, HttpResponse.BodyHandlers.ofString())
if (respuesta.statusCode() != 200) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('No se obtuvo la sesión del gestor: HTTP ' + respuesta.statusCode())
    return
}
props.put('tokenGestor', new groovy.json.JsonSlurper().parseText(respuesta.body()).accessToken)
SampleResult.setResponseMessage('Sesión del gestor preparada')</stringProp>
</JSR223Sampler>
<hashTree/>
      </hashTree>

        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Ruta de la identidad">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Identidad: misma jornada, mismos despachos y misma secuencia que la fila CSV de la muestra.
import groovy.json.JsonSlurper
if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('HTTP_' + prev.getResponseCode())
    return
}
def fallos = []
def ruta
try {
    ruta = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('RESPUESTA_INVALIDA')
    return
}
if (ruta.idJornada != vars.get('idJornada')) fallos &lt;&lt; 'JORNADA_INCORRECTA'
def esperado = vars.get('despachos').split(';').toList().sort()
def obtenido = (ruta.despachos ?: []).collect { it.idDespacho + ':' + it.secuenciaRuta }.sort()
if (obtenido != esperado) fallos &lt;&lt; 'RUTA_INCORRECTA'
if (fallos) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(fallos.join(' '))
}</stringProp>
</JSR223Assertion>
<hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Etiqueta de la fase">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// La muestra se registra con la fase en la que salió.
prev.setSampleLabel(vars.get('faseRuta'))</stringProp>
</JSR223PostProcessor>
<hashTree/>

# Para Docker Compose usar el .env de la raíz del backend; esta plantilla es para Maven o el IDE.
# Plantilla local: trasladar estas variables al IDE o al proceso.
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
SEGURIDAD_ALGORITMO=RS256
PORT=8081
GATEWAY_PUBLIC_URL=http://localhost:8080
OPERACION_REPARTO_URL=http://localhost:8082
# JWT técnico vigente para la API interna; obtenerlo del mecanismo acordado por el equipo.
# OPERACION_TOKEN_SERVICIO=<credencial-tecnica-solo-en-el-servidor>
OPERACION_CLIENT_ID=modulo-despacho
# Para obtención/renovación automática mediante Seguridad, usar su secreto real fuera de Git.
# OPERACION_CLIENT_SECRET=<secreto-tecnico-solo-en-el-servidor>
SPRING_PROFILES_ACTIVE=integracion-local
# Fuera del perfil local: configurar la base de datos exclusiva de este servicio.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<base>
# SPRING_DATASOURCE_USERNAME=<usuario>
# SPRING_DATASOURCE_PASSWORD=<secreto-fuera-de-git>

# F-02 requiere PostgreSQL y un perfil distinto de integracion-local (por ejemplo, default).
PRODUCTOS_URL=http://localhost:8083
PRODUCTOS_CLIENT_ID=modulo-despacho
# PRODUCTOS_CLIENT_SECRET=<secreto-del-cliente-tecnico>
# PRODUCTOS_TOKEN_SERVICIO=<jwt-tecnico-vigente-para-api-productos>
VENTAS_URL=http://localhost:8084
VENTAS_CLIENT_ID=modulo-despacho
# VENTAS_CLIENT_SECRET=<secreto-del-cliente-tecnico>
# VENTAS_TOKEN_SERVICIO=<jwt-tecnico-vigente-para-api-ventas>
# Los permisos técnicos de reservas/proyecciones se configuran según el proveedor de Operación.
# OPERACION_CAPACIDAD_SCOPES=<scopes-internos-concedidos>

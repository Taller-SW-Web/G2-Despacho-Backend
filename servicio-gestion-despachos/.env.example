# Plantilla para ejecutar este servicio individualmente o configurar Render.
# Para Docker local se utiliza únicamente el .env raíz y compose.yaml.
# Copiar los valores al entorno del proceso o al panel de Render; no guardar secretos en Git.
SPRING_PROFILES_ACTIVE=render
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
SEGURIDAD_ALGORITMO=RS256
# Base exclusiva: Servicio Logístico (región oeste). Copiar valores privados desde Supabase al panel de Render.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-de-esta-base>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-de-esta-base>
SPRING_DATASOURCE_PASSWORD=<secreto-fuera-de-git>
SPRING_FLYWAY_ENABLED=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
GATEWAY_PUBLIC_URL=https://taller-api-gateway.onrender.com
DOCUMENTACION_HABILITADA=false
OPERACION_REPARTO_URL=https://taller-servicio-operacion-reparto.onrender.com
OPERACION_CAPACIDAD_SCOPES=operacion:capacidad:reservar operacion:capacidad:liberar operacion:proyecciones:escribir
# Recepción física y procesador durable de Gestión (ES-F04-03).
RECEPCION_PROCESADOR_HABILITADO=true
RECEPCION_INTERVALO_PROCESADOR_MS=1000
RECEPCION_ESPERAS=PT30S,PT2M,PT10M,PT30M,PT1H
# Conceder esos scopes al cliente real en Seguridad; no guardar secretos aquí.

DEMO_SIN_AUTENTICACION=false
OPERACION_CLIENT_ID=modulo-despacho
# OPERACION_CLIENT_SECRET=<secreto-real-del-cliente>
# OPERACION_TOKEN_SERVICIO=<jwt-tecnico-opcional>
# PRODUCTOS_URL=https://<servicio-productos>
# PRODUCTOS_CLIENT_ID=modulo-despacho
# PRODUCTOS_CLIENT_SECRET=<secreto-real-del-cliente>
# PRODUCTOS_TOKEN_SERVICIO=<jwt-tecnico-opcional>
# VENTAS_URL=https://<servicio-ventas>
# VENTAS_CLIENT_ID=modulo-despacho
# VENTAS_CLIENT_SECRET=<secreto-real-del-cliente>
# VENTAS_TOKEN_SERVICIO=<jwt-tecnico-opcional>

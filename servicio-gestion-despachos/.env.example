# Plantilla de Gestión de Despachos para Render. Para Docker local, usar el .env raíz.
# Sustituir los dominios .example.invalid por los orígenes oficiales. Cargar secretos solo en Render.

# ==================== Despliegue y documentación ====================

# Perfil de despliegue con PostgreSQL externo y Flyway desactivado por defecto.
SPRING_PROFILES_ACTIVE=render
# Puerto HTTP del proceso. Render lo proporciona automáticamente.
# PORT=8081
# URL pública del Gateway para enlaces de la API.
GATEWAY_PUBLIC_URL=https://gateway-despacho.example.invalid
# Con true, OpenAPI y Swagger UI quedan accesibles sin JWT en la URL directa del servicio.
# Usar true si quieren publicar la documentación durante una integración o demostración.
DOCUMENTACION_HABILITADA=false

# ==================== Seguridad (G7) ====================

# URL base de Seguridad (G7), sin /api/v1. Se usa para validar JWT y solicitar tokens técnicos.
SEGURIDAD_URL=https://seguridad.example.invalid
# Audiencia esperada en los tokens de servicio dirigidos a Despacho.
SEGURIDAD_AUDIENCIA=api-despacho
# Algoritmo de firma admitido para los JWT.
SEGURIDAD_ALGORITMO=RS256

# ==================== PostgreSQL y migraciones ====================

# URL JDBC de la base exclusiva de Gestión (Servicio Logístico).
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-de-gestion>:5432/postgres?sslmode=require
# Usuario de PostgreSQL de Gestión.
SPRING_DATASOURCE_USERNAME=<usuario-de-gestion>
# Contraseña de PostgreSQL de Gestión.
SPRING_DATASOURCE_PASSWORD=
# Mantener false en Render hasta conciliar el esquema y el historial de migraciones.
SPRING_FLYWAY_ENABLED=false
# Máximo de conexiones del pool JDBC del servicio.
DB_POOL_MAXIMO=2
# Mínimo de conexiones inactivas del pool JDBC.
DB_POOL_MINIMO=0

# ==================== Integración con Productos ====================

# URL base oficial de Productos, sin /api/v1. Se usa en cotizaciones exactas y al crear despachos.
PRODUCTOS_URL=https://productos.example.invalid
# Identificador técnico de Gestión para consultar datos físicos de SKU.
PRODUCTOS_CLIENT_ID=modulo-despacho
# Secreto de G7 para obtener un token con aud=api-productos y scope productos:fisicos:leer.
PRODUCTOS_CLIENT_SECRET=
# Alternativa al secreto. Un JWT técnico no vacío tiene prioridad y debe renovarse antes de vencer.
PRODUCTOS_TOKEN_SERVICIO=

# ==================== Eventos hacia Ventas ====================

# URL base de Ventas, sin /api/v1. Gestión agrega /api/v1/integraciones/despachos/eventos.
VENTAS_URL=https://ventas.example.invalid
# Identificador técnico de Gestión para enviar estados a Ventas.
VENTAS_CLIENT_ID=modulo-despacho
# Secreto de G7 para obtener un token con aud=api-ventas y scope ventas:pedidos:estado.
VENTAS_CLIENT_SECRET=
# Alternativa al secreto. Un JWT técnico no vacío tiene prioridad y debe renovarse antes de vencer.
VENTAS_TOKEN_SERVICIO=

# ==================== Integración con Operación ====================

# URL base de Operación para asignar, reasignar y liberar capacidad.
OPERACION_REPARTO_URL=https://operacion-reparto.example.invalid
# Identificador técnico interno. Operación exige que el cliente sea modulo-despacho.
OPERACION_CLIENT_ID=modulo-despacho
# Secreto de G7 para pedir el token de servicio interno. Estas rutas no exigen scopes.
OPERACION_CLIENT_SECRET=
# Alternativa al secreto. Un JWT técnico no vacío tiene prioridad y debe renovarse antes de vencer.
OPERACION_TOKEN_SERVICIO=

# ==================== Límite de cotizaciones ====================

# Máximo de llamadas a POST /api/v1/cotizaciones por minuto para cada combinación de cliente e IP.
# Al superar el cupo, Gestión responde HTTP 429 hasta que empieza el siguiente minuto.
LIMITE_COTIZACIONES_POR_MINUTO=60

# ==================== Recepción física y reintentos ====================

# Habilita el procesador de liberaciones pendientes tras la recepción física de paquetes.
RECEPCION_PROCESADOR_HABILITADO=true
# Intervalo de revisión de pendientes, en milisegundos.
RECEPCION_INTERVALO_PROCESADOR_MS=1000
# Esperas entre reintentos del procesador, como duraciones ISO 8601 separadas por comas.
RECEPCION_ESPERAS=PT30S,PT2M,PT10M,PT30M,PT1H

# ==================== Modo demo ====================

# Mantener desactivado el modo de demostración sin autenticación en Render.
DEMO_SIN_AUTENTICACION=false
# Identidad ficticia usada únicamente cuando se habilita la demo.
DEMO_USUARIO_ID=00000000-0000-4000-8000-000000000001

# Referencia para ejecutar el emisor de pruebas directamente con Java.
# Java lee estas variables del proceso. Docker Compose ya fija su propio entorno.
# Este emisor es exclusivo de desarrollo local y utiliza identidades ficticias.

# ==================== Habilitación ====================

# Habilitación explícita del emisor temporal en una ejecución local.
HABILITAR_SEGURIDAD_LOCAL=true

# ==================== Red local ====================

# Puerto HTTP del emisor.
PORT=8090
# Limita la escucha a la máquina local en la ejecución directa.
DIRECCION_ESCUCHA=127.0.0.1

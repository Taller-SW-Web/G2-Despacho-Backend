# Plantilla de Operación de Reparto para Render. Para Docker local, usar el .env raíz.
# Sustituir los dominios .example.invalid por las URLs de tu ambiente. Cargar secretos solo en Render.

# ==================== Despliegue y documentación ====================

# Perfil de despliegue con PostgreSQL externo y Flyway desactivado por defecto.
SPRING_PROFILES_ACTIVE=render
# Puerto HTTP del proceso. Render lo proporciona automáticamente.
# PORT=8082
# URL pública del Gateway para enlaces de la API.
GATEWAY_PUBLIC_URL=https://gateway-despacho.example.invalid
# Con true, OpenAPI y Swagger UI quedan accesibles sin JWT en la URL directa del servicio.
# Usar true si quieren publicar la documentación durante una integración o demostración.
DOCUMENTACION_HABILITADA=false

# ==================== Seguridad (G7) ====================

# URL base de Seguridad (G7), sin /api/v1. Se usa para validar JWT y solicitar tokens técnicos.
SEGURIDAD_URL=https://seguridad.example.invalid
# Audiencia esperada en los tokens de servicio dirigidos a Despacho.
SEGURIDAD_AUDIENCIA=api-despacho
# Algoritmo de firma admitido para los JWT.
SEGURIDAD_ALGORITMO=RS256

# ==================== PostgreSQL y migraciones ====================

# URL JDBC de la base exclusiva de Operación (Operadores y Flota).
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-de-operacion>:5432/postgres?sslmode=require
# Usuario de PostgreSQL de Operación.
SPRING_DATASOURCE_USERNAME=<usuario-de-operacion>
# Contraseña de PostgreSQL de Operación.
SPRING_DATASOURCE_PASSWORD=
# Mantener false en Render hasta conciliar el esquema y el historial de migraciones.
SPRING_FLYWAY_ENABLED=false
# Máximo de conexiones del pool JDBC del servicio.
DB_POOL_MAXIMO=2
# Mínimo de conexiones inactivas del pool JDBC.
DB_POOL_MINIMO=0

# ==================== Integración con Gestión ====================

# URL base de Gestión para solicitar transiciones internas del despacho.
GESTION_DESPACHOS_URL=https://gestion-despachos.example.invalid
# Identificador técnico interno. Gestión exige que el cliente sea modulo-despacho.
GESTION_CLIENT_ID=modulo-despacho
# Secreto de G7 para pedir el token de servicio interno. Estas rutas no exigen scopes.
GESTION_CLIENT_SECRET=
# Alternativa al secreto. Un JWT técnico no vacío tiene prioridad y debe renovarse antes de vencer.
GESTION_TOKEN_SERVICIO=

# ==================== Evidencias de entrega ====================

# URL base del proyecto Supabase Storage que aloja las fotos de evidencia.
EVIDENCIAS_STORAGE_URL=
# Nombre del bucket privado de evidencias.
EVIDENCIAS_BUCKET=
# Clave de servicio del proyecto de Storage, de uso exclusivo del backend.
EVIDENCIAS_CLAVE_SERVICIO=
# Tipos MIME admitidos en fotos de evidencia, separados por comas.
EVIDENCIAS_TIPOS_PERMITIDOS=image/jpeg,image/png,image/webp
# Tamaño máximo de una foto de evidencia, en bytes.
EVIDENCIAS_MAXIMO_BYTES=2097152

# ==================== Modo demo ====================

# Mantener desactivado el modo de demostración sin autenticación en Render.
DEMO_SIN_AUTENTICACION=false
# Identidad ficticia usada únicamente cuando se habilita la demo.
DEMO_USUARIO_ID=00000000-0000-4000-8000-000000000001

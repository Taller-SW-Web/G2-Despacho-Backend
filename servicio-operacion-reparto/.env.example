# Para Docker Compose usar el .env de la raíz del backend; esta plantilla es para Maven o el IDE.
# Plantilla local: trasladar estas variables al IDE o al proceso.
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
# Activar solo durante la demostración publicada; no requiere un emisor JWT.
DEMO_SIN_AUTENTICACION=false
# Actor UUID usado en auditoría; para operaciones de campo debe corresponder al perfil elegido.
DEMO_USUARIO_ID=00000000-0000-4000-8000-000000000001
SEGURIDAD_ALGORITMO=RS256
PORT=8082
GATEWAY_PUBLIC_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=integracion-local
# Política fijada por el esquema V3 de evidencias; los límites del bucket privado deben coincidir.
EVIDENCIAS_TIPOS_PERMITIDOS=image/jpeg,image/png,image/webp
EVIDENCIAS_MAXIMO_BYTES=2097152
# Requeridas para autorizar cargas reales; mantener la clave fuera de Git.
# EVIDENCIAS_STORAGE_URL=https://<proyecto>.supabase.co
# EVIDENCIAS_CLAVE_SERVICIO=<secreto-fuera-de-git>
# EVIDENCIAS_BUCKET=<bucket-privado>
# Fuera del perfil local: configurar la base de datos exclusiva de este servicio.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<base>
# SPRING_DATASOURCE_USERNAME=<usuario>
# SPRING_DATASOURCE_PASSWORD=<secreto-fuera-de-git>

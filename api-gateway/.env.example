# Plantilla para ejecutar este servicio individualmente o configurar Render.
# Para Docker local se utiliza únicamente el .env raíz y compose.yaml.
# Copiar los valores al entorno del proceso o al panel de Render; no guardar secretos en Git.
SPRING_PROFILES_ACTIVE=render
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
SEGURIDAD_ALGORITMO=RS256
GESTION_DESPACHOS_URL=https://taller-servicio-gestion-despachos.onrender.com
OPERACION_REPARTO_URL=https://taller-servicio-operacion-reparto.onrender.com
CORS_ORIGENES=https://despacho-administrativo.vercel.app,https://despacho-repartidor.vercel.app

DEMO_SIN_AUTENTICACION=false
SOLICITUD_MAXIMO_BYTES=1048576

# Para Docker Compose usar el .env de la raíz del backend; esta plantilla es para Maven o el IDE.
# Plantilla: trasladar estas variables al IDE o al proceso. No se carga automáticamente.
SEGURIDAD_URL=https://<host-real-de-seguridad>
SEGURIDAD_AUDIENCIA=api-despacho
# Activar junto con ambos microservicios durante la demostración.
DEMO_SIN_AUTENTICACION=false
SEGURIDAD_ALGORITMO=RS256
PORT=8080
GESTION_DESPACHOS_URL=http://localhost:8081
OPERACION_REPARTO_URL=http://localhost:8082
CORS_ORIGENES=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082
SOLICITUD_MAXIMO_BYTES=1048576

# Plantilla del API Gateway para Render. Para Docker local, usar el .env raíz con compose.yaml.
# Sustituir los dominios .example.invalid por las URLs de tu ambiente.

# ==================== Despliegue ====================

# Perfil que carga las rutas y los orígenes publicados.
SPRING_PROFILES_ACTIVE=render
# Puerto HTTP del proceso. Render lo proporciona automáticamente.
# PORT=8080

# ==================== Seguridad (G7) ====================

# URL base de Seguridad. Se usa para validar JWT y enrutar el acceso humano.
SEGURIDAD_URL=https://seguridad.example.invalid
# Audiencia esperada en los tokens de servicio dirigidos a Despacho.
SEGURIDAD_AUDIENCIA=api-despacho
# Algoritmo de firma admitido para los JWT.
SEGURIDAD_ALGORITMO=RS256

# ==================== Rutas hacia los servicios ====================

# URL base de Gestión para cotizaciones, despachos, seguimiento y zonas.
GESTION_DESPACHOS_URL=https://gestion-despachos.example.invalid
# URL base de Operación para repartidores, jornadas, flota y evidencias.
OPERACION_REPARTO_URL=https://operacion-reparto.example.invalid

# ==================== CORS y tamaño de solicitudes ====================

# Orígenes HTTPS de los frontends admitidos por CORS, separados por comas.
CORS_ORIGENES=https://despacho-administrativo.example.invalid,https://despacho-repartidor.example.invalid
# Tamaño máximo del cuerpo de la solicitud, en bytes.
SOLICITUD_MAXIMO_BYTES=1048576

# ==================== Modo demo ====================

# Mantener desactivado el modo de demostración sin autenticación en Render.
DEMO_SIN_AUTENTICACION=false
